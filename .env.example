# Browser-safe Supabase values. Publishable keys are designed to be public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_. Used by Next.js only to enqueue jobs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Worker-only Supabase credentials. These may point at the same project as the web app.
WORKER_SUPABASE_URL=https://your-project-ref.supabase.co
WORKER_SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# AI adapters. "auto" uses fal when FAL_KEY is set, then an adapter-specific
# key when present, and finally the deterministic local fallback.
# FAL_KEY is worker-only. Never rename it with a NEXT_PUBLIC_ prefix.
FAL_KEY=
FAL_ROUTING_PROFILE=balanced
FAL_MODEL_OVERRIDES={}
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
CONTENT_ANALYSIS_PROVIDER=auto
CONTENT_ANALYSIS_API_URL=https://api.openai.com/v1/chat/completions
CONTENT_ANALYSIS_API_KEY=
CONTENT_ANALYSIS_MODEL=gpt-4.1-mini

# Worker controls.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_POLL_INTERVAL_MS=3000
WORKER_VISIBILITY_TIMEOUT_SECONDS=1800
WORKER_TEMP_ROOT=/tmp/scene-forge
WORKER_TEMP_MAX_AGE_HOURS=24
LOG_LEVEL=info

# App limits. Bucket restrictions and server validation enforce the same maximum.
MAX_UPLOAD_BYTES=2147483648
SIGNED_URL_TTL_SECONDS=3600
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
DEPLOYMENT_VERSION=local
